# Copy to .env and fill in. Never commit .env.
MCPHUB_ISSUER=http://localhost:8080/realms/mcp-hub
MCPHUB_JWKS_URL=http://localhost:8080/realms/mcp-hub/protocol/openid-connect/certs
MCPHUB_AUDIENCE=mcp-hub
MCPHUB_PUBLIC_URL=http://localhost:8000

MCPHUB_GITHUB_TOKEN=
MCPHUB_JIRA_BASE_URL=https://your-site.atlassian.net
MCPHUB_JIRA_EMAIL=
MCPHUB_JIRA_API_TOKEN=
MCPHUB_SLACK_BOT_TOKEN=

# Deny-by-default scope allowlists (JSON lists). Empty = nothing allowed.
MCPHUB_ALLOWED_REPOS=["your-user/your-sandbox-repo"]
MCPHUB_ALLOWED_JIRA_PROJECTS=["SBX"]
MCPHUB_ALLOWED_SLACK_CHANNELS=["C0123456789"]

MCPHUB_AUDIT_DB=./data/audit.db
# stdio only: a real Keycloak access token to run as that user
MCPHUB_STDIO_TOKEN=
